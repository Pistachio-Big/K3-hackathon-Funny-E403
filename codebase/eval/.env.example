# .env.example — Mẫu cấu hình biến môi trường cho RAG pipeline
#
# Sao chép file này thành `.env` rồi điền API key thật:
#   cp codebase/eval/.env.example codebase/eval/.env
#   (hoặc chỉ sửa codebase/eval/.env nếu đã có)
#
# ⚠ QUAN TRỌNG: file `.env` nằm trong `.gitignore` của repo, KHÔNG commit key lên git.

# Gemini API key — lấy từ https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: chọn model khác nếu key có quyền truy cập model khác
# Mặc định: text-embedding-004 (embed) + gemini-3-flash (generate)
GEMINI_MODEL_EMBED=text-embedding-004
GEMINI_MODEL_GEN=gemini-3-flash