# .env.example — Mẫu cấu hình biến môi trường cho RAG pipeline
#
# Sao chép file này thành `.env` rồi điền API key thật:
#   cp codebase/eval/.env.example codebase/eval/.env
#   (hoặc chỉ sửa codebase/eval/.env nếu đã có)
#
# ⚠ QUAN TRỌNG: file `.env` nằm trong `.gitignore` của repo, KHÔNG commit key lên git.

# OpenRouter API key — lấy từ https://openrouter.ai/keys
# Dùng cho chat + tool calling (mọi sinh câu trả lời)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Jina API key — lấy từ https://jina.ai/api-dashboard/key-manager
# Dùng để embed query (jina-embeddings-v3, 1024 dims)
JINA_API_KEY=your-jina-api-key-here

# Optional: chọn model khác nếu key có quyền truy cập model khác
# Mặc định: openai/gpt-4o-mini
EVAL_MODEL=openai/gpt-4o-mini

# Optional: Tavily cho web research fallback
TAVILY_API_KEY=
