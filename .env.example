# .env.example — biến môi trường cho docker-compose
# Copy thành .env rồi điền giá trị thật.
# File này KHÔNG nên commit (đã có trong .gitignore).

# Bắt buộc — Gemini API key (lấy từ https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Tuỳ chọn — model Gemini
GEMINI_MODEL_EMBED=text-embedding-004
GEMINI_MODEL_GEN=gemini-3-flash

# Vector DB
QDRANT_COLLECTION=vlearn_tutor
VECTOR_DIM=768