# .env.example — biến môi trường cho docker-compose
# Copy thành .env rồi điền giá trị thật.
# File này KHÔNG nên commit (đã có trong .gitignore).

# Bắt buộc — OpenRouter API key (chat + tool calling)
OPENROUTER_API_KEY=

# Bắt buộc — Jina API key (embed query bằng jina-embeddings-v3, 1024 dims)
JINA_API_KEY=

# Tuỳ chọn — OpenRouter model cho generation
EVAL_MODEL=openai/gpt-4o-mini

# Vector DB
QDRANT_COLLECTION=vlearn_tutor
VECTOR_DIM=1024

# Tuỳ chọn — Web research (Tavily)
TAVILY_API_KEY=
