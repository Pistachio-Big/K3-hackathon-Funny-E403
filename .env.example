# Unified .env.example file for VLearn Tutor (Docker Compose & Local Execution)

# LLM & Embedding API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
JINA_API_KEY=your_jina_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_EMBED=gemini-embedding-2
GEMINI_MODEL_GEN=gemini-3.5-flash-lite

# Vector DB & App Config
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=vlearn_tutor
VECTOR_DIM=1024
PORT=3000
EVAL_MODEL=openai/gpt-4o-mini
